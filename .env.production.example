# Copy only on VPS to .env.production; chmod 600. Never reuse local credentials.
APP_ENV=production
POSTGRES_USER=portfolio_prod
POSTGRES_DB=portfolio_prod
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SITE_URL=https://carlosandre.tech
CORS_ORIGINS=["https://carlosandre.tech"]
COOKIE_SECURE=true
ADMIN_SESSION_HOURS=8
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace@example.com
SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=replace@example.com
SMTP_USE_STARTTLS=true
CONTACT_NOTIFICATION_EMAIL=replace@example.com
RELEASE_TAG=initial
# Optional editorial defaults; missing values require explicit review.
DOCX_DEFAULT_AUTHOR=
DOCX_DEFAULT_CATEGORY=
DOCX_DEFAULT_TAGS=[]
DOCX_STAGING_MINUTES=60
