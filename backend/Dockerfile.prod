FROM python:3.12-slim AS build
WORKDIR /build
COPY requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=build /wheels /wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt && rm -rf /wheels && useradd --uid 10001 --create-home appuser
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
# Context permissions may be 0600/0700 (for example, a restrictive host umask).
# Keep code root-owned and immutable to appuser, but readable/traversable.
RUN find /app/app /app/alembic -type d -exec chmod 0755 {} + \
    && find /app/app /app/alembic -type f -exec chmod 0644 {} + \
    && chmod 0755 /app \
    && chmod 0644 /app/alembic.ini /app/requirements.txt \
    && install -d -o appuser -g appuser -m 0750 /app/uploads
USER appuser
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
