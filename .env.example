# Copie para .env e substitua a senha antes de iniciar.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio
APP_ENV=development
SITE_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080"]
COOKIE_SECURE=false
ADMIN_SESSION_HOURS=8
# SMTP: preencha host, usuário, senha do provedor e remetente autorizado.
# O contato confirma a gravação no banco; notificações Gmail podem ser reenviadas no painel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=pericacs@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pericacs@gmail.com
CONTACT_NOTIFICATION_EMAIL=pericacs@gmail.com
