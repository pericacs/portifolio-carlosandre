    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@vinext/cloudflare": "^1.1.1",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "postcss": "latest",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
