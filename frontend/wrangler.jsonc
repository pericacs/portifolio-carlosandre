{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carlosandre-preview",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "cloudflare/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {"SITE_URL":"http://localhost:3001","ACCESS_REQUIRED":"true","EMAIL_ENABLED":"false","EMAIL_FROM":"notificacoes@carlosandre.tech"},
  "d1_databases": [{"binding":"DB","database_name":"carlosandre-preview","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"cloudflare/migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"carlosandre-preview-media"}],
  "send_email": [{"name":"EMAIL","destination_address":"pericacs@gmail.com"}],
  "triggers": {"crons":["*/5 * * * *"]},
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
